{
  "name": "maestro-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Maestro — orquestrador multiagente do ecossistema EXECUTAR como Claude Code Plugin (ledger de estado, roteamento de skills, ingestão governada de componentes e servidores MCP).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\" \"tests/repo/**/*.test.ts\"",
    "test:e2e": "bash scripts/e2e.sh",
    "validate": "node dist/cli/maestro.js validate",
    "render": "node dist/cli/maestro.js render",
    "validate:plugin": "node scripts/validate-official.mjs",
    "check": "bash scripts/check.sh",
    "upstream:sync": "bash scripts/upstream-sync.sh",
    "upstream:status": "git submodule status vendor/upstream",
    "cloudflare:check": "cd cloudflare-worker && npm run check",
    "cloudflare:deploy": "cd cloudflare-worker && npm run deploy",
    "cloudflare:configure": "node scripts/configure-cloudflare-route.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
