{
  "description": "Guardrails do Maestro (contratos/C-00) no nível do plugin — valem também dentro de subagentes (EV-010).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/session-context.js\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/guard-write.js\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/guard-external.js\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/validate-on-write.js\"", "timeout": 15 }
        ]
      }
    ]
  }
}
